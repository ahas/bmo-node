{
  "name": "bmo-node-client",
  "version": "0.1.0-rev.2",
  "description": "The node service's client, generated from its OpenAPI document: every body as a type and a typed call for every route.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../docs/openapi.json --output src/schema.ts",
    "check": "bun check.ts && tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
